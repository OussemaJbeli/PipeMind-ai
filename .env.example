APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8001
SERVICE_VERSION=0.1.0
CONTRACT_VERSION=v1

# Must match AI_SERVICE_TOKEN in PipeMind-back/.env
SERVICE_TOKEN=change-me-shared-secret

# Ports match PipeMind-back/.env (5434 / 6380 — see the note there)
DATABASE_URL=postgresql+psycopg://pipemind:secret@localhost:5434/pipemind
REDIS_URL=redis://localhost:6380/3

# --- LLM (reasoning) --------------------------------------------------------
# stub = deterministic fake, no key needed. Builds files 07-16 end to end.
# Switch to gemini when the API key is available. See roadmaps/06 §6.9.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
MAX_CONTEXT_TOKENS=8000

# --- Embeddings (independent of the LLM — local, no key, CPU) ---------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# --- Log processing ---------------------------------------------------------
MAX_LOG_CHARS=60000
EXCERPT_CONTEXT_LINES=15
REDACTION_STRICT=true

# --- Retrieval --------------------------------------------------------------
# Both thresholds are measured, not chosen: see
# PipeMind-data/experiments/similarity-threshold.md and knowledge-retrieval.md.
# Raising either makes retrieval return nothing, which looks exactly like
# "no relevant history exists" and reports no error.
SIMILARITY_THRESHOLD=0.55
MAX_SIMILAR_FAILURES=5
KNOWLEDGE_THRESHOLD=0.40
# Seeds match on similarity; the neighbours around them usually hold the fix,
# because only the symptom section of a runbook is written in the words of the
# error. Radius must move with the chunk size.
MAX_KNOWLEDGE_SEEDS=3
KNOWLEDGE_NEIGHBOUR_RADIUS=2
MAX_KNOWLEDGE_CHUNKS=6

# --- Cost -------------------------------------------------------------------
MONTHLY_COST_CEILING_USD=25
